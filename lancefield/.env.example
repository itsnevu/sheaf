# SQLite by default; any Prisma-supported URL works after switching the provider.
DATABASE_URL="file:./dev.db"
# Signs session cookies and hashes agent tokens. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Public origin used in the agent guide and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3200
# Load the clearly labelled demo season on first run (1) or start empty (0).
SEED_DEMO=1
