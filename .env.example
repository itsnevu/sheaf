# ── Database ─────────────────────────────────────────────────────────────────
# SQLite by default (zero setup). For PostgreSQL switch provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ── Sessions ─────────────────────────────────────────────────────────────────
# Secret used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── Execution mode ───────────────────────────────────────────────────────────
# demo  → the mock provider simulates routes, funding and every leg. No chain calls, no funds.
# real  → the Relay adapter quotes live routes into Elysium; funding and legs are
#         signed by the connected desk wallet. The desk contracts in contracts/ are not yet
#         called by the app (see docs/implementation-status.md).
# The mode is decided server-side and shown in the UI. It never switches silently.
SHEAF_MODE=demo

# ── Relay (only read when SHEAF_MODE=real) ─────────────────────────────────
# Public API works without a key at 50 quote requests/minute. A key raises limits and is
# required when you set a referrer. Never expose it to the browser (no NEXT_PUBLIC_ prefix).
RELAY_API_URL=https://api.relay.link
RELAY_API_KEY=
# Optional referrer label sent with quotes (requires RELAY_API_KEY).
RELAY_REFERRER=

# ── Networks (real mode) ─────────────────────────────────────────────────────
# Chain the desk funds from, and the chain legs settle on. Both must be in Relay's GET /chains
# list. Defaults: Elysium (99801) → Elysium (99801), USDG (6 decimals).
# A different origin chain makes Relay route the funding into Elysium.
RAQIO_ORIGIN_CHAIN_ID=99801
RAQIO_DESTINATION_CHAIN_ID=99801
# USDG contract on Elysium. Required for real mode; verify against Relay /currencies/v2.
RAQIO_USDG_ADDRESS_99801=
# Browser RPC for the wallet (optional; wagmi falls back to the chain's public RPC).
NEXT_PUBLIC_RPC_URL_99801=
# WalletConnect project id (https://cloud.reown.com). Empty = injected wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Worker ───────────────────────────────────────────────────────────────────
# The execution worker runs in-process (instrumentation.ts). Set to "off" on serverless hosts
# and call POST /api/worker/run with the WORKER_SECRET from a cron instead.
WORKER_MODE=in-process
WORKER_SECRET=change-me
WORKER_INTERVAL_MS=2000

NEXT_PUBLIC_APP_URL=http://localhost:3100

# ── Raqio Contracts (Elysium) ────────────────────────────────────────────────
NEXT_PUBLIC_RAQIO_STREAM_ADDRESS=
NEXT_PUBLIC_FEE_ROUTER_ADDRESS=
NEXT_PUBLIC_RAQIO_VAULT_ADDRESS=
NEXT_PUBLIC_RAQIO_AIRDROP_ADDRESS=
NEXT_PUBLIC_RAQIO_SCORE_ADDRESS=
NEXT_PUBLIC_ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# Foundry deployment configuration (do not add private keys to this file).
ELYSIUM_RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
FEE_ROUTER_ADDRESS=
RAQIO_ADMIN_ADDRESS=

# ── Data protection ──────────────────────────────────────────────────────────
# AES-256-GCM key for personal data at rest (leg labels, memos, CSV originals).
# 64 hex characters. Required in production. Generate: openssl rand -hex 32
# Losing this key makes those fields unreadable; back it up with the database.
RAQIO_ENCRYPTION_KEY=
# Sign-in/sign-up rate limiting (on by default). Set to "off" only for automated tests.
RAQIO_RATE_LIMIT=on
